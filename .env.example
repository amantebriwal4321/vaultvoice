# Lyzr Studio key. When this is empty, VaultVoice uses the local mock agents.
LYZR_API_KEY=
# Optional. One agent id used for Router, Privacy Guard, and Answer.
LYZR_AGENT_ID=
# Optional. Per role ids from Studio, or written by the auto create step.
LYZR_ROUTER_AGENT_ID=
LYZR_GUARD_AGENT_ID=
LYZR_ANSWER_AGENT_ID=
# Optional override. Default is the public Studio inference host.
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai

# Qdrant Cloud. When URL is empty, the app uses the local qdrant-client store.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=vaultvoice_notes

# Set to 1 to use in memory Qdrant instead of data/qdrant.
QDRANT_IN_MEMORY=0
# hash skips the neural embedder. Default is fastembed all-MiniLM-L6-v2.
EMBEDDER=fastembed
PORT=8741
